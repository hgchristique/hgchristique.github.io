PORT=3001

# Hubtel API credentials (Hubtel dashboard > Settings > API keys)
HUBTEL_API_ID=your_api_id_here
HUBTEL_API_KEY=your_api_key_here
# Collection account / POS sales number that receives the money
HUBTEL_MERCHANT_ACCOUNT=your_collection_account_here

# Where customers are sent back to after paying (the shop frontend, no trailing slash)
SITE_URL=http://localhost:2000
# Public URL of this server, used by Hubtel to deliver payment callbacks (no trailing slash)
PUBLIC_API_URL=http://localhost:3001

# Allowed origin(s) for CORS, comma-separated (your frontend URL)
ALLOWED_ORIGIN=http://localhost:2000
